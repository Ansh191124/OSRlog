# Server
PORT=8000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas - replace with your real connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/osr_logistics?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# AWS S3 - replace with your real credentials
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=osr-logistics-files
